# Copy this file to .env and fill in your MySQL details
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=wardwatch
# Set to true for cloud MySQL (TiDB Cloud, Aiven...). Leave false for local MySQL.
DB_SSL=false

# Optional. If empty, a key is derived from DB_PASSWORD.
SESSION_SECRET=

# Optional, used by "npm run seed" for the officer account on public deployments
SEED_OFFICER_PASSWORD=

PORT=3000
